{
  "name": "@janrau/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SHOW_DRAFTS=1 astro dev",
    "build": "pnpm prepare:data && astro build",
    "build:drafts": "SHOW_DRAFTS=1 pnpm build",
    "preview": "astro preview",
    "typecheck": "pnpm --filter @janrau/cv-render render site-data && astro check",
    "test": "playwright test",
    "deploy": "pnpm build && wrangler deploy",
    "prepare:data": "pnpm --filter @janrau/cv-render render pdf && pnpm --filter @janrau/cv-render render og && pnpm --filter @janrau/cv-render render site-data && pnpm --filter @janrau/elevator build-index"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@janrau/elevator": "workspace:*",
    "@janrau/schema": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
