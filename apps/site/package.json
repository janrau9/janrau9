{
  "name": "@janrau/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SHOW_DRAFTS=1 astro dev",
    "build": "pnpm --filter @janrau/cv-render render pdf && astro build",
    "build:drafts": "SHOW_DRAFTS=1 pnpm build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "playwright test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@janrau/schema": "workspace:*",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
