---
import { env } from "cloudflare:workers";
import TailoredPage from "../../components/organisms/TailoredPage.astro";
import Base from "../../components/templates/Base.astro";
import { classifyOpen, recordEvent } from "../../lib/events";
import { lookup } from "../../lib/tailored";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const result = await lookup(env.DB, slug);

// The link may be fine but the database isn't: show the general page, never an error.
if (result.kind === "unavailable") {
  console.error(`tailored page ${slug} unavailable: ${result.reason}`);
  return Astro.redirect("/", 302);
}
if (result.kind === "missing") Astro.response.status = 404;

// ?preview: my own checks, never counted. Otherwise record the open without delaying the page,
// keeping only whether it looks like a scanner, not who it was.
const preview = Astro.url.searchParams.has("preview");
if (result.kind === "found" && !preview && env.DB) {
  const db = env.DB;
  const cf = (Astro.request as Request & { cf?: { asn?: number } }).cf;
  const verdict = classifyOpen({
    userAgent: Astro.request.headers.get("user-agent"),
    asn: cf?.asn,
    secondsSincePublish: result.publishedAt === null ? undefined : Math.floor(Date.now() / 1000) - result.publishedAt,
  });
  const write = recordEvent(db, slug, "open", verdict).catch((err) => console.error(`event write failed: ${err}`));
  Astro.locals.cfContext?.waitUntil(write);
}

const view = result.kind === "found" ? result.view : undefined;
const pdf = `/for/${slug}/cv.pdf`;
---

{
  view ? (
    <Base title={`Janrau Beray · for ${view.company}`} description={view.headline} noindex cvHref={pdf}>
      <TailoredPage view={view} slug={slug} pdf={pdf} track={!preview} />
    </Base>
  ) : (
    <Base title="Link not found · Janrau Beray" description="This link does not exist." noindex>
      <div class="page measure stack-24">
        <h1 class="display">link not found</h1>
        <p class="text-2">This link doesn't exist. It may be mistyped. My general portfolio is one click away.</p>
        <p>
          <a class="button button-outline" href="/">
            Go to the portfolio
          </a>
        </p>
      </div>
    </Base>
  )
}
