---
import { env } from "cloudflare:workers";
import TailoredPage from "../../../components/organisms/TailoredPage.astro";
import Base from "../../../components/templates/Base.astro";
import { verifyAccess } from "../../../lib/access";
import { adminEmail } from "../../../lib/admin-env";
import { lookup } from "../../../lib/tailored";

export const prerender = false;

if (!(await adminEmail(Astro.request, verifyAccess))) return new Response("Forbidden", { status: 403 });
const slug = Astro.params.slug ?? "";
const result = await lookup(env.DB, slug, { includeUnpublished: true });
if (result.kind !== "found") return new Response("Not found", { status: 404 });

const row = await env.DB?.prepare(
  "SELECT a.published_at, a.status, v.variant_json FROM applications a JOIN variants v ON v.slug = a.slug WHERE a.slug = ?",
)
  .bind(slug)
  .first<{ published_at: number | null; status: string; variant_json: string }>();
const variant = JSON.parse(row?.variant_json ?? "{}") as {
  gaps?: string[];
  formAnswers?: { question: string; limit?: number; answer: string }[];
};
const published = row?.published_at != null;
const publicUrl = `https://janrau.dev/for/${slug}`;
const { view } = result;
---

<Base title={`Review · ${view.company}`} description="Private review" noindex cvHref={`/admin/files/${slug}/cv.pdf`}>
  <aside class="review frame" aria-labelledby="review-title">
    <div class="panel">
      <p class="micro"><a href="/admin">← Applications</a></p>

      <header class="stack-8">
        <h2 id="review-title">{view.company}</h2>
        <p class="small text-2">{view.role}</p>
      </header>

      <publish-button data-slug={slug} data-published={published ? "1" : undefined} data-url={publicUrl}>
        <div class="actions">
          <button type="button" class="button button-ink publish" hidden={published}>Publish</button>
          <button type="button" class="button button-outline unpublish" hidden={!published}>Unpublish</button>
          <p class="micro state" role="status" aria-live="polite">
            {published ? `Live at ${publicUrl.replace("https://", "")}` : "Not published: only you can see this page."}
          </p>
        </div>
        <div class="confirm stack-8" hidden>
          <p class="small">Unpublish? Anyone with the link will see “not found” until you publish again.</p>
          <div class="row">
            <button type="button" class="button button-outline confirm-yes">Take it offline</button>
            <button type="button" class="link-button small confirm-no">Keep it live</button>
          </div>
        </div>
      </publish-button>

      <div class="details rows">
        <div class="alcove">
          <p class="micro">Attachments</p>
          <p class="row small">
            <a href={`/admin/files/${slug}/cv.pdf`}>CV (PDF)</a>
            <a href={`/admin/files/${slug}/cover-letter.pdf`}>Cover letter (PDF)</a>
            <a href={`/for/${slug}/cv.pdf`}>Page CV with note</a>
          </p>
        </div>

        {
          variant.formAnswers?.length ? (
            <div class="alcove">
              <p class="micro">Form answers</p>
              <ul class="list-plain stack-24">
                {variant.formAnswers.map((f) => (
                  <li class="stack-8">
                    <p class="small text-2">
                      {f.question}
                      {f.limit ? ` · ${f.answer.length} / ${f.limit} characters` : ` · ${f.answer.length} characters`}
                    </p>
                    <p class="answer small">{f.answer}</p>
                    <copy-text data-text={f.answer}>
                      <button type="button" class="link-button micro">
                        Copy answer
                      </button>
                    </copy-text>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        <div class="alcove">
          <p class="micro">Gaps</p>
          {
            variant.gaps?.length ? (
              <details open={variant.gaps.length <= 3}>
                <summary class="small text-2">
                  {variant.gaps.length} {variant.gaps.length === 1 ? "requirement" : "requirements"} without
                  evidence · never published
                </summary>
                <ul class="small text-2 bullets">
                  {variant.gaps.map((g) => (
                    <li>{g}</li>
                  ))}
                </ul>
              </details>
            ) : (
              <p class="small text-2">None listed.</p>
            )
          }
        </div>
      </div>
    </div>
  </aside>

  <TailoredPage view={view} slug={slug} pdf={`/for/${slug}/cv.pdf`} track={false} />
</Base>

<script>
  const REVERT_MS = 1597;

  /**
   * Publish island: Publish and Unpublish, each confirmed by the server. Unpublishing is
   * destructive for anyone holding the link, so it asks first, in words (never red).
   */
  class PublishButton extends HTMLElement {
    connectedCallback() {
      const publishBtn = this.querySelector<HTMLButtonElement>(".publish");
      const unpublishBtn = this.querySelector<HTMLButtonElement>(".unpublish");
      const confirm = this.querySelector<HTMLElement>(".confirm");
      const yes = this.querySelector<HTMLButtonElement>(".confirm-yes");
      const no = this.querySelector<HTMLButtonElement>(".confirm-no");
      const state = this.querySelector<HTMLElement>(".state");
      const { slug, url } = this.dataset;
      if (!publishBtn || !unpublishBtn || !confirm || !yes || !no || !state || !slug || !url) return;
      const link = url.replace("https://", "");

      const show = (published: boolean, message: string, kind: "saved" | "error" | "idle" = "idle") => {
        publishBtn.hidden = published;
        unpublishBtn.hidden = !published;
        confirm.hidden = true;
        publishBtn.disabled = unpublishBtn.disabled = false;
        publishBtn.textContent = "Publish";
        unpublishBtn.textContent = "Unpublish";
        this.dataset.state = kind;
        state.textContent = message;
      };
      const call = async (path: string) => {
        const res = await fetch(path, {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ slug }),
        });
        const data = (await res.json()) as { ok: boolean; message?: string };
        if (!res.ok || !data.ok) throw new Error(data.message ?? `HTTP ${res.status}`);
      };
      const why = (err: unknown) => (err instanceof Error ? err.message : "no connection");

      publishBtn.addEventListener("click", async () => {
        publishBtn.disabled = true;
        publishBtn.textContent = "Publishing…";
        try {
          await call("/admin/api/publish");
          show(true, `Live ✓ ${link}`, "saved");
        } catch (err) {
          show(false, `Not published: ${why(err)}. The link is still private.`, "error");
        }
      });
      unpublishBtn.addEventListener("click", () => {
        unpublishBtn.hidden = true;
        confirm.hidden = false;
        yes.focus();
      });
      no.addEventListener("click", () => show(true, `Live at ${link}`));
      yes.addEventListener("click", async () => {
        yes.disabled = true;
        yes.textContent = "Taking it offline…";
        try {
          await call("/admin/api/unpublish");
          yes.textContent = "Take it offline";
          show(false, "Offline ✓ The link shows “not found”. Publish again to restore it.", "saved");
        } catch (err) {
          yes.disabled = false;
          yes.textContent = "Take it offline";
          show(true, `Still live: ${why(err)}.`, "error");
        }
      });
    }
  }

  /** Copies a form answer, with a short-lived cue. */
  class CopyText extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      const text = this.dataset.text;
      if (!button || text === undefined) return;
      let revert: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener("click", async () => {
        clearTimeout(revert);
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = "Copied ✓";
        } catch {
          button.textContent = "Copy failed: select the text instead";
        }
        revert = setTimeout(() => (button.textContent = "Copy answer"), REVERT_MS);
      });
    }
  }

  customElements.define("publish-button", PublishButton);
  customElements.define("copy-text", CopyText);
</script>

<style>
  .review {
    padding-top: 40px;
  }
  /* The panel is a surface: a thing acted on as a unit, above the page it reviews. */
  .panel {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 13px;
    box-shadow: var(--shadow-1);
  }
  @media (min-width: 610px) {
    .panel {
      padding: 40px;
    }
  }
  /* The action and its outcome sit together, under the title, at any title length. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  .publish:disabled,
  .unpublish:disabled,
  .confirm-yes:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .confirm {
    padding-top: 16px;
  }
  publish-button[data-state="saved"] .state {
    color: var(--ink);
  }
  publish-button[data-state="error"] .state {
    color: var(--seal);
  }
  /* Hairline above the details: one boundary, one rung. */
  .details {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .bullets {
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  details > summary {
    cursor: pointer;
    min-height: 24px;
  }
  details[open] > summary {
    margin-bottom: 8px;
  }
  .answer {
    white-space: pre-wrap;
    padding: 8px 16px;
    border-left: 1px solid var(--line-strong);
  }
  .link-button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  [hidden] {
    display: none !important;
  }
</style>
