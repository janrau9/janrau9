---
import "../../styles/global.css";
import Elevator from "../organisms/Elevator.astro";
import Footer from "../organisms/Footer.astro";
import Strip from "../organisms/Strip.astro";

interface Props {
  title: string;
  description: string;
  /** Private pages (tailored links) must never appear in search results. */
  noindex?: boolean;
  /** Tailored pages link their own PDF. */
  cvHref?: string;
  /** The page's own heading carries the seal (the name's j), so the wordmark doesn't. */
  sealInHeading?: boolean;
  /** Link-preview image, generated by `render og` into public/og/. */
  image?: { path: string; alt: string };
}

const { title, description, noindex = false, cvHref, sealInHeading = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = Astro.props.image ?? { path: "/og/home.png", alt: "janrau beray, Software Engineer" };
const imageUrl = new URL(image.path, Astro.site);
// Cloudflare Web Analytics: cookieless page counts for the public pages only. Private pages
// (tailored links, admin) have their own event log. Set only in the deploy job, so local
// and CI test builds make no third-party requests.
const beacon = noindex ? undefined : import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f6f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a11" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline src="/sky-init.js"></script>
    {
      beacon && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beacon })}
        />
      )
    }
  </head>
  <body>
    <a class="skip micro" href="#main">Skip to content</a>
    <Strip cvHref={cvHref} seal={!sealInHeading}><Elevator /></Strip>
    <main id="main" class="frame">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 24px;
    top: -64px;
    z-index: var(--z-toast);
    padding: 8px 16px;
    background: var(--raised);
    border-radius: 8px;
  }
  .skip:focus {
    top: 8px;
  }
</style>
