---
import { CV_PDF } from "../../lib/content";
import SealedText from "../atoms/SealedText.astro";
import SkyToggle from "../atoms/SkyToggle.astro";

interface Props {
  /** Tailored pages link their own PDF. */
  cvHref?: string | undefined;
  /**
   * False when the page's heading carries the seal: one seal per view. The nav's j-dot then
   * rests in ink and takes the seal only while that heading is out of view (the hand-off).
   */
  seal?: boolean;
}
const { cvHref = CV_PDF, seal = true } = Astro.props;
---

<header class="strip">
  <nav class="frame strip-inner" aria-label="Main">
    <a href="/" class:list={["mark", { handoff: !seal }]}><SealedText text="janrau" /></a>
    <div class="row links">
      <a href="/#work">Work</a>
      <a href={cvHref}>CV</a>
      <slot />
      <SkyToggle />
    </div>
  </nav>
</header>

<style>
  .strip {
    position: sticky;
    top: 0;
    z-index: var(--z-strip);
    background: color-mix(in oklab, var(--ground) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-hover) var(--settle);
  }
  /* The strip earns its hairline only once content scrolls beneath it. */
  :global(html.scrolled) .strip {
    border-bottom-color: var(--line);
  }
  .strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  .mark {
    font-weight: 600;
    text-decoration: none;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
  }
  .handoff :global(.tittle) {
    background: var(--ink);
    transition: background-color var(--t-entrance) var(--settle);
  }
  :global(html.seal-handoff) .handoff :global(.tittle) {
    background: var(--seal);
  }
  .links a {
    font-size: 14px;
    color: var(--text-2);
    text-decoration: none;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
  }
  .links a:hover {
    color: var(--ink);
  }
</style>

<script>
  const mark = () => document.documentElement.classList.toggle("scrolled", window.scrollY > 8);
  mark();
  window.addEventListener("scroll", mark, { passive: true });

  // The hand-off: while the heading's seal is hidden (above the strip or off screen), the nav's j-dot holds it.
  const heading = document.querySelector(".handoff") && document.querySelector("main .tittle");
  if (heading) {
    new IntersectionObserver(([e]) => document.documentElement.classList.toggle("seal-handoff", !e?.isIntersecting), {
      rootMargin: "-64px 0px 0px 0px",
    }).observe(heading);
  }
</script>
