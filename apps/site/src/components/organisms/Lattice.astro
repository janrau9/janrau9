---
// The kikkō lattice (seiza texture, locked construction): grid-true hexagons, edge 21,
// drawn in the --line token; every exposed edge a ragged frontier rolled per visit;
// the still pond answers the pointer; one lattice cell is washed in the seal.
// Shuhari, named: the home page breaks "one seal per view" on purpose. The dot of the j is
// the mark; the lattice cell is the sky's. Two vermilion marks, neither on a status.
// Decorative: aria-hidden, pointer-events none, hidden until its frontier mask exists.
---

<div class="field" id="lattice" aria-hidden="true">
  <div class="lattice"></div>
  <div class="cells"></div>
</div>

<script>
  const HW = 36.3731; // cell width
  const HM = HW / 2;
  const PITCH = 31.5; // row pitch
  const field = document.getElementById("lattice");
  const cellsEl = field?.querySelector<HTMLElement>(".cells");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** quiet: behind text, so it never rises (a risen cell lowers the text's contrast). */
  type Cell = { x: number; y: number; el: HTMLElement; t?: number; r?: number; quiet?: boolean };
  let cells: Cell[] = [];
  let seal: Cell | undefined;

  const hexPath = (cx: number, cy: number) =>
    `M${cx} ${cy - 22}L${cx + 19.05} ${cy - 11}L${cx + 19.05} ${cy + 11}L${cx} ${cy + 22}L${cx - 19.05} ${cy + 11}L${cx - 19.05} ${cy - 11}Z`;

  /** Random depth per column (or row): each edge stops at its own place, 0–2 whole cells in. */
  const jitter = (n: number) => Array.from({ length: n + 3 }, () => Math.floor(Math.random() * 3));

  function build() {
    if (!field || !cellsEl) return;
    const { width: w, height: h } = field.getBoundingClientRect();
    // Not laid out (hidden): no field, no seal cell.
    if (w === 0 || h === 0) {
      cells = [];
      seal = undefined;
      cellsEl.replaceChildren();
      return;
    }
    const rows = Math.ceil(h / PITCH) + 1;
    const cols = Math.ceil(w / HW) + 1;
    const jTop = jitter(cols);
    const jBottom = jitter(cols);
    const jLeft = jitter(rows);
    const jRight = jitter(rows);

    let d = "";
    cells = [];
    cellsEl.replaceChildren();
    for (let r = 0; r < rows; r++) {
      const cy = 21 + r * PITCH;
      const off = r % 2 === 0 ? HM : 0;
      for (let c = 0; c <= cols; c++) {
        const cx = off + c * HW;
        const col = Math.min(cols, Math.round(cx / HW));
        // Whole cells only: a cell is kept when its full outline sits inside the box, minus
        // 0–2 cells of jitter per column (top, bottom) and per row (left, right). The box
        // edge never cuts a cell, so no edge is ever an aligned cutoff.
        const keep =
          cy - 21 >= (jTop[col] ?? 0) * PITCH &&
          cy + 21 <= h - (jBottom[col] ?? 0) * PITCH &&
          cx - HM >= (jLeft[r] ?? 0) * HW &&
          cx + HM <= w - (jRight[r] ?? 0) * HW;
        if (!keep) continue;
        d += hexPath(Math.round(cx * 10) / 10, cy);
        const el = document.createElement("div");
        el.className = "hex-cell";
        el.style.transform = `translate(${cx - HM}px, ${cy - 21}px)`;
        cellsEl.append(el);
        cells.push({ x: cx, y: cy, el });
      }
    }
    const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='${w}' height='${h}'><path d='${d}' fill='white'/></svg>`;
    field.style.maskImage = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
    field.style.setProperty("-webkit-mask-image", field.style.maskImage);

    // The seal: one kept cell, away from the frontier and never under text, where red would
    // fight the words. Grey cells may pass behind text; the seal may not.
    const box = field.getBoundingClientRect();
    const textRects = [...(field.closest(".hero")?.querySelectorAll("h1, p, li, a, button") ?? [])]
      .map((el) => el.getBoundingClientRect())
      .filter((r) => r.width > 0 && r.height > 0)
      .map((r) => ({ left: r.left - box.left - 8, right: r.right - box.left + 8, top: r.top - box.top - 8, bottom: r.bottom - box.top + 8 }));
    const clear = (c: Cell) =>
      !textRects.some((r) => c.x + HM > r.left && c.x - HM < r.right && c.y + 21 > r.top && c.y - 21 < r.bottom);
    for (const c of cells) c.quiet = !clear(c);
    const inner = cells.filter((c) => cells.filter((o) => Math.hypot(o.x - c.x, o.y - c.y) < HW * 1.1).length >= 7);
    const pool = [inner.filter(clear), cells.filter(clear), inner, cells].find((list) => list.length > 0) ?? [];
    seal = pool[Math.floor(Math.random() * pool.length)];
    seal?.el.classList.add("seal-cell");
    field.classList.add("ready");
  }

  function surge(cell: Cell, amp: number, dwell: number, red = false) {
    if (cell.quiet) return;
    const el = cell.el;
    clearTimeout(cell.t);
    clearTimeout(cell.r);
    el.classList.toggle("red", red);
    el.style.transition = "opacity 144ms cubic-bezier(0.16, 1, 0.3, 1)";
    el.style.opacity = String(amp);
    cell.t = window.setTimeout(() => {
      el.style.transition = "opacity 610ms ease";
      el.style.opacity = "";
      if (red) cell.r = window.setTimeout(() => el.classList.remove("red"), 640);
    }, dwell);
  }

  /** The pointer moved on: the cell settles back over 610ms. */
  function release(cell: Cell) {
    cell.el.style.transition = "opacity 610ms ease";
    cell.el.style.opacity = "";
  }

  /** A strike: a constant-speed circular front, amplitude = spreading × absorption. */
  function wave(ox: number, oy: number, red = false) {
    for (const cell of cells) {
      const dist = Math.hypot(cell.x - ox, cell.y - oy);
      const ring = dist / HW;
      const amp = (0.55 * Math.exp(-ring / 13)) / Math.sqrt(1 + ring);
      if (amp < 0.05) continue;
      window.setTimeout(() => surge(cell, amp, 89, red), dist * (55 / HW));
    }
  }

  const local = (e: PointerEvent | MouseEvent) => {
    const box = field?.getBoundingClientRect();
    return box ? { x: e.clientX - box.left, y: e.clientY - box.top } : { x: -1e9, y: -1e9 };
  };
  const nearest = (x: number, y: number) => {
    let best: Cell | undefined;
    let bestD = HM;
    for (const c of cells) {
      const dd = Math.hypot(c.x - x, c.y - y);
      if (dd < bestD) {
        bestD = dd;
        best = c;
      }
    }
    return best;
  };

  build();

  if (!still && field) {
    let resting: Cell | undefined;
    let frame = 0;
    document.addEventListener(
      "pointermove",
      (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const { x, y } = local(e);
          const cell = nearest(x, y);
          if (cell === resting) return;
          if (resting) release(resting);
          resting = cell;
          if (!cell || cell.quiet) return;
          // Rest: the cell under the pointer rises and stays; ring-1 neighbours leave a dying wake.
          clearTimeout(cell.t);
          cell.el.style.transition = "opacity 144ms cubic-bezier(0.16, 1, 0.3, 1)";
          cell.el.style.opacity = cell === seal ? "0.68" : "0.55";
          for (const n of cells)
            if (n !== cell && Math.hypot(n.x - cell.x, n.y - cell.y) < HW * 1.1) surge(n, 0.25, 144);
        });
      },
      { passive: true },
    );
    document.addEventListener("click", (e) => {
      const { x, y } = local(e);
      if (!nearest(x, y)) return;
      const onSeal = seal && Math.hypot(seal.x - x, seal.y - y) < HW * 0.75;
      wave(x, y, Boolean(onSeal));
    });
    // Arrival: once, the seal strikes the water, then stillness.
    window.setTimeout(() => seal && wave(seal.x, seal.y), 987);
    let resize = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resize);
      resize = window.setTimeout(build, 233);
    });
  }
</script>

<style>
  .field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--t-entrance) ease;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }
  .field.ready {
    opacity: 1;
  }
  .lattice,
  .cells {
    position: absolute;
    inset: 0;
  }
  /* The lines are drawn as an image in each sky's --line colour (day #e4e1da, night #24242d),
     not as a masked fill: accessibility checkers ignore masks and would read a solid box behind
     the hero text, while an image they rightly treat as a pattern. */
  .lattice {
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='36.3731'%20height='63'%3E%3Cpath%20d='M0%2010.5%20L18.1865%200%20L36.3731%2010.5%20M0%2010.5%20V31.5%20M36.3731%2010.5%20V31.5%20M0%2031.5%20L18.1865%2042%20L36.3731%2031.5%20M18.1865%2042%20V63'%20fill='none'%20stroke='%23e4e1da'%20stroke-width='1'/%3E%3C/svg%3E");
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .lattice {
      background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='36.3731'%20height='63'%3E%3Cpath%20d='M0%2010.5%20L18.1865%200%20L36.3731%2010.5%20M0%2010.5%20V31.5%20M36.3731%2010.5%20V31.5%20M0%2031.5%20L18.1865%2042%20L36.3731%2031.5%20M18.1865%2042%20V63'%20fill='none'%20stroke='%2324242d'%20stroke-width='1'/%3E%3C/svg%3E");
    }
  }
  :global(:root[data-theme="dark"]) .lattice {
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='36.3731'%20height='63'%3E%3Cpath%20d='M0%2010.5%20L18.1865%200%20L36.3731%2010.5%20M0%2010.5%20V31.5%20M36.3731%2010.5%20V31.5%20M0%2031.5%20L18.1865%2042%20L36.3731%2031.5%20M18.1865%2042%20V63'%20fill='none'%20stroke='%2324242d'%20stroke-width='1'/%3E%3C/svg%3E");
  }
  .cells :global(.hex-cell) {
    position: absolute;
    left: 0;
    top: 0;
    width: 36.3731px;
    height: 42px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: var(--line-strong);
    opacity: 0;
  }
  .cells :global(.hex-cell.seal-cell) {
    background: var(--seal);
    opacity: 0.34;
  }
  .cells :global(.hex-cell.red) {
    background: var(--seal);
  }
</style>
