---
// One kikkō cell, the lattice's own shape, as an outline icon: pointy-top like the lattice,
// 1.5px stroke, round joins, a 16px box (seiza's icon geometry).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["hex", className]} viewBox="0 0 24 24" aria-hidden="true">
  <path d="M12 2.5 20.23 7.25v9.5L12 21.5l-8.23-4.75v-9.5Z"></path>
</svg>

<style>
  .hex {
    flex: none;
    width: 16px;
    height: 16px;
    fill: transparent;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
