                    ]
                  }
                },
                "projects": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "text",
                "tags"
              ],
              "additionalProperties": false
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "chose": {
                  "type": "string",
                  "minLength": 3
                },
                "over": {
                  "type": "string",
                  "minLength": 3
                },
                "because": {
                  "type": "string",
                  "minLength": 10
                },
                "tags": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "accessibility",
                      "ai",
                      "algorithms",
                      "architecture",
                      "backend",
                      "ci",
                      "cloud",
                      "correctness",
                      "cost",
                      "data",
                      "data-modelling",
                      "delivery",
                      "design",
