                "ownership",
                "parsing",
                "performance",
                "product",
                "python",
                "quality",
                "real-time",
                "security",
                "sync",
                "systems",
                "teamwork",
                "testing",
                "tooling"
              ]
            }
          }
        },
        "required": [
          "id",
          "text",
          "tags"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^proj\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "in-use",
              "beta",
              "building",
              "archived"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 220
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "repo": {
            "anyOf": [
              {
                "type": "string",
                "const": "private"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "stack": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featured": {
            "type": "boolean"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
