                "because",
                "tags"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "summary",
          "repo",
          "stack"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^skill\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "accessibility",
                "ai",
                "algorithms",
                "architecture",
                "backend",
                "ci",
